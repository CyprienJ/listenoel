{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.2.4",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://noscadeaux.fr",
  "icons": {
    "16": "icons/noscadeaux-16.png",
    "32": "icons/noscadeaux-32.png",
    "48": "icons/noscadeaux-48.png",
    "96": "icons/noscadeaux-96.png"
  },
  "permissions": [
    "activeTab",
    "identity",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://noscadeaux.fr/*",
    "https://www.noscadeaux.fr/*"
  ],
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "__MSG_addThisProduct__",
    "default_icon": {
      "16": "icons/noscadeaux-16.png",
      "32": "icons/noscadeaux-32.png"
    }
  },
  "sidebar_action": {
    "default_title": "__MSG_quickAdd__",
    "default_panel": "sidebar/index.html",
    "default_icon": {
      "16": "icons/noscadeaux-16.png",
      "32": "icons/noscadeaux-32.png"
    },
    "open_at_install": false
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-add@noscadeaux.fr",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent"
        ]
      },
      "strict_min_version": "140.0"
    }
  }
}
